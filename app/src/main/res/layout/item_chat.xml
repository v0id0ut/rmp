<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvChatInitials"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@color/light_blue_bg"
        android:gravity="center"
        android:text="МН"
        android:textColor="@color/primary_blue"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChatPartner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Мария Новикова"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChatTopic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Гитара с нуля ↔ Разбор портфолио"
            android:textColor="@color/primary_blue"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvChatLastMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Отлично! Возьму вторую гитару 🎸"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvChatTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="9:41"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>